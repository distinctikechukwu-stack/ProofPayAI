# Shared local development values. Replace placeholders in .env only.
API_PORT=4000
APP_ORIGIN=http://localhost:5173

# Supabase server credentials. Never expose the service-role key to Vite/browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend may use only the public URL and anon key.
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI provider. The app must show Not configured until a valid key is supplied.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-supported-model

# PayPal Sandbox only. Never put these in VITE_* variables.
PAYPAL_SANDBOX_CLIENT_ID=your-sandbox-client-id
PAYPAL_SANDBOX_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
