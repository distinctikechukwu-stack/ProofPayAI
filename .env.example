# Shared local development values. Replace placeholders in .env only.
API_PORT=4000
APP_ORIGIN=http://localhost:5173

# Supabase project URL and API keys. Prefer current sb_publishable_/sb_secret_ keys.
SUPABASE_URL=
# Public key used by the API for user-scoped Auth/Data API requests.
SUPABASE_ANON_KEY=
# Privileged server-only key. Never expose this value to Vite/browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Frontend may use only the project URL and public publishable key.
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider secrets are API-server-only; never use VITE_* names for these.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI is an alternative. Set AI_PROVIDER=openai to select it.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-supported-model

# PayPal Sandbox only. Never put these in VITE_* variables.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
