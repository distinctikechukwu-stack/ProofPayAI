{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofpay-staging-paypal-webhook",
  "main": "../api/src/cloudflare-paypal-webhook.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "PAYPAL_SANDBOX_CLIENT_ID",
      "PAYPAL_SANDBOX_CLIENT_SECRET",
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "PAYPAL_WEBHOOK_QUEUE",
        "queue": "proofpay-staging-paypal-events"
      }
    ],
    "consumers": [
      {
        "queue": "proofpay-staging-paypal-events",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "proofpay-staging-paypal-events-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
